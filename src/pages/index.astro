---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import ngc6523 from "../assets/ngc6523-bvo.jpg";
const features = [
  ["01", "Data ingestion & setup", "Upload ALMA spectral cubes, species catalogs and fitting configuration before launching a run."],
  ["02", "SLURM-managed fitting", "Launch and monitor multi-pixel, multi-species LTE fitting jobs across HPC resources, with ML-assisted strategy selection."],
  ["03", "Species-resolved inspection", "Browse single- and multi-species results pixel by pixel, with convergence history and live diagnostics."],
  ["04", "Volumetric & synthetic tools", "Render 3D parameter volumes, generate synthetic spectra and inspect transition-combination maps."]
];
const parameters = ["Column density · log N", "Excitation temperature · Tex", "Line-of-sight velocity · VLSR", "Linewidth · FWHM"];
const tabs = [
  "A. Upload",
  "B. Launch Jobs",
  "C. Multiple Species Viewer",
  "D. Single Species Viewer",
  "E. 3D Volume",
  "TMP: Synthetic Spectra Generator",
  "TMP: Launch Jobs by Epochs",
  "TMP: Transition Combo Maps"
];
const metrics = [
  ["Tex", "132 K"],
  ["log N", "14.8"],
  ["VLSR", "41.2 km/s"],
  ["FWHM", "6.4 km/s"]
];
---
<BaseLayout>
  <div class="topline">
    <a class="brand" href="#top"><span class="brand-mark">M³</span><span>AI-ITACA / ASTROCHEMISTRY SOFTWARE</span></a>
    <nav aria-label="Main navigation">
      <a href="#about">ABOUT</a><a href="#workflow">INTERFACE</a><a href="#science">SCIENCE</a><a href="#team">TEAM</a>
    </nav>
    <a class="top-cta" href="https://github.com/" target="_blank" rel="noreferrer">GITHUB ↗</a>
  </div>

  <main id="top">
    <section class="hero wrap">
      <div class="hero-grid">
        <div class="hero-copy">
          <span class="eyebrow">AI-ITACA / MMT24-CAB-01 · MOMENTUM PROGRAM</span>
          <h1>M<sup>3</sup>FIT<span class="period">.</span></h1>
          <p class="hero-description">HPC-based multi-species LTE spectral fitting, assisted by machine learning, for complete ALMA spectral cubes.</p>
          <div class="hero-actions">
            <a class="button" href="#about">EXPLORE THE PROJECT <span>↘</span></a>
            <a class="text-link mono" href="#workflow">DISCOVER THE INTERFACE ↗</a>
          </div>
          <div class="hero-tags mono">
            <span>HPC</span><span>LTE</span><span>ML</span><span>SLURM</span><span>ALMA</span>
          </div>
        </div>
        <div class="app-window" aria-label="M3FIT application preview">
          <div class="app-titlebar">
            <span class="dot"></span><span class="dot"></span><span class="dot"></span>
            <span class="app-path mono">m3fit / single-species-viewer</span>
          </div>
          <div class="app-tabs mono" aria-label="Application tabs preview">
            {tabs.slice(0, 5).map((t, i) => <span class={`tab ${i === 3 ? "active" : ""}`}>{t}</span>)}
          </div>
          <div class="app-body">
            <aside class="app-sidebar mono">
              <span class="eyebrow">PARAMETERS</span>
              {metrics.map(([k, v]) => <div class="chip"><span>{k}</span><strong>{v}</strong></div>)}
            </aside>
            <div class="app-graphic">
              <div class="graphic-label mono">FIG. 01 / SPECTRAL SIGNATURE</div>
              <svg viewBox="0 0 1100 250" role="img" aria-label="Illustrative molecular spectral lines">
                <path class="axis" d="M0 205H1100 M40 20V220" />
                <path class="gridline" d="M40 65H1100 M40 135H1100" />
                <path class="spectrum" d="M40 203 L100 202 145 200 185 201 220 197 245 188 260 100 270 185 290 198 340 201 390 199 420 193 438 150 450 196 480 201 535 199 565 194 590 75 603 188 620 198 680 201 720 199 745 182 765 120 778 190 805 199 850 201 900 200 925 188 940 45 953 185 975 199 1030 202 1100 201" />
                <path class="peak" d="M260 100V220 M590 75V220 M940 45V220" />
                <circle cx="260" cy="100" r="4"/><circle cx="590" cy="75" r="4"/><circle cx="940" cy="45" r="4"/>
              </svg>
              <div class="graphic-foot mono"><span>INTENSITY</span><span>FREQUENCY →</span><span>ILLUSTRATIVE DATA</span></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="about" class="section wrap">
      <div class="section-head">
        <span class="eyebrow">01 / THE PROJECT</span>
        <div><h2>From spectral cubes<br />to physical insight.</h2></div>
      </div>
      <figure class="about-banner">
        <Image src={ngc6523} alt="NGC 6523, the Lagoon Nebula, illustrative deep-sky observation" width={1400} />
        <figcaption class="mono">NGC 6523 · LAGOON NEBULA (ILLUSTRATIVE)</figcaption>
      </figure>
      <div class="about-text">
        <p><strong>M³FIT</strong> <strong>(Multi-species Molecular Machine-learning-assisted FITting)</strong> tool is a High-Performance Computing (HPC)-based software developed within the framework of the <strong>Artificial Intelligence Integral Tool for AstroChemical Analysis</strong> (<strong>AI-ITACA</strong>, ID: MMT24-CAB-01 - Momentum program). It combines multi-species Local Thermodynamic Equilibrium (LTE) spectral fitting with Machine Learning (ML) techniques to enable the efficient and semi-automated characterization of complete ALMA spectral cubes. Running on a SLURM-managed HPC infrastructure, the tool is designed to identify suitable molecular transitions, optimize fitting strategies, and characterize large numbers of spatial pixels across spectral cubes. Depending on the available observational constraints, it derives key physical parameters, including column density (log <em>N</em>), excitation temperature <em>T</em>ex, line-of-sight velocity <em>V</em>LSR, and linewidth (Full Width at Half Maximum, FWHM), producing spatially resolved FITS maps, synthetic LTE spectra, and fitting diagnostics to assess the quality of the solutions. The initial scientific exploitation will focus on the identification and characterization of molecular sources using datasets from GUAPOS project and ALMA Science Verification observations.</p>
      </div>
      <div class="stat-grid">
        <div class="stat-card"><strong>HPC</strong><span>SLURM-managed<br />job orchestration</span></div>
        <div class="stat-card"><strong>ML</strong><span>Strategy selection<br />and convergence guidance</span></div>
        <div class="stat-card"><strong>LTE</strong><span>Multi-species<br />spectral modelling</span></div>
        <div class="stat-card"><strong>FITS</strong><span>Spatially resolved<br />physical-parameter maps</span></div>
      </div>
    </section>

    <section id="workflow" class="section panel">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">02 / INTERFACE & CAPABILITIES</span>
          <div><h2>Built around<br />the fitting pipeline.</h2>
            <p>Each stage of the analysis — from cube ingestion to volumetric inspection — is exposed as a dedicated tab in the application, mirroring the actual processing pipeline used to characterize ALMA spectral cubes.</p>
          </div>
        </div>
        <div class="feature-grid">
          {features.map(([n, title, desc]) => <article class="feature-card">
            <span class="eyebrow">{n} / CAPABILITY</span><h3>{title}</h3><p>{desc}</p><span class="feature-arrow accent">↗</span>
          </article>)}
        </div>
        <div class="tab-strip mono" aria-label="Application tabs">
          {tabs.map((t, i) => <span class={`tab ${i === 3 ? "active" : ""}`}>{t}</span>)}
        </div>
      </div>
    </section>

    <section id="science" class="section wrap">
      <div class="section-head">
        <span class="eyebrow">03 / OUTPUT PARAMETERS</span>
        <div><h2>Quantifying the<br />molecular gas.</h2>
          <p>Depending on the available observational constraints, the fitting procedure derives key physical parameters and produces spatially resolved FITS maps, synthetic LTE spectra and fitting diagnostics to assess the quality of each solution.</p>
        </div>
      </div>
      <div class="parameter-layout">
        <div class="parameter-list panel-card">
          {parameters.map((p, i) => <div class="parameter"><span class="eyebrow">0{i+1}</span><strong>{p}</strong><span class="parameter-arrow">↗</span></div>)}
        </div>
        <div class="output-card panel-card">
          <span class="eyebrow">OUTPUT / PRODUCTS</span>
          <div class="output-visual">
            <div class="map-grid"></div>
            <div class="map-cross"></div>
            <span class="map-tag mono">PIXEL MAP / PREVIEW</span>
          </div>
          <p>Spatially resolved FITS maps, synthetic LTE spectra and fitting diagnostics per pixel and per species.</p>
        </div>
      </div>
    </section>

    <section class="context panel">
      <div class="wrap context-inner">
        <span class="eyebrow">04 / SCIENTIFIC MOTIVATION</span>
        <h2>Understanding the<br /><em>molecular inventory</em><br />of the interstellar medium.</h2>
        <p>The increasing complexity of molecules identified in the interstellar medium (ISM), together with the unprecedented sensitivity of modern facilities such as ALMA and the James Webb Space Telescope (JWST), is opening new opportunities to investigate the molecular inventory of the Universe. However, the rapidly increasing volume of astronomical data, particularly with the forthcoming ALMA Wideband Sensitivity Upgrade (WSU), poses major challenges to conventional approaches for spectral analysis and molecular characterization. Developing automated, scalable, and efficient techniques is therefore essential to fully exploit these observations. By combining physically motivated LTE modelling, ML-assisted analysis, and HPC capabilities, this tool aims to accelerate the extraction of astrochemical information from large spectroscopic datasets, contributing to a more comprehensive understanding of molecular complexity in the ISM and the potential role of interstellar chemistry in the emergence of prebiotic building blocks.</p>
      </div>
    </section>

    <section id="team" class="section wrap team">
      <div class="section-head">
        <span class="eyebrow">05 / FRAMEWORK & DATA</span>
        <div><h2>Developed for<br />collaborative science.</h2>
          <p>M³FIT is developed within AI-ITACA. Initial scientific exploitation focuses on molecular-source identification and characterization using datasets from the GUAPOS project and ALMA Science Verification observations.</p>
        </div>
      </div>
      <div class="data-strip panel-card">
        <span class="eyebrow">INITIAL DATASETS</span>
        <strong>GUAPOS</strong><strong>ALMA SCIENCE VERIFICATION</strong>
      </div>
      <div class="team-bottom">
        <div class="credits">
          <p class="eyebrow">PI · <strong class="credit-name">Victor Rivilla Rodríguez</strong></p>
          <p class="eyebrow">Dev · <strong class="credit-name">Gabriel Jaimes Illanes</strong></p>
        </div>
        <a class="button light" href="https://github.com/" target="_blank" rel="noreferrer">VIEW SOURCE CODE <span>↗</span></a>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap footer-inner">
      <a class="brand" href="#top"><span class="brand-mark">M³</span><span>M³FIT / AI-ITACA</span></a>
      <span class="eyebrow">© 2026 · AI-ITACA · CSIC / Centro de Astrobiología</span>
      <a class="eyebrow" href="#top">BACK TO TOP ↑</a>
    </div>
  </footer>
</BaseLayout>

<style>
  .topline { height: 72px; display:flex; align-items:center; justify-content:space-between; padding:0 max(24px, calc((100vw - 1160px)/2)); border-bottom:1px solid var(--line); gap:24px; }
  .brand { display:flex; align-items:center; gap:12px; font:10px var(--mono); letter-spacing:.08em; }
  .brand-mark { display:grid; place-items:center; width:30px; height:30px; border:1px solid var(--ink); border-radius:50%; font:700 12px var(--sans); letter-spacing:-.04em; }
  nav { display:flex; gap:8px; font:10px var(--mono); letter-spacing:.06em; }
  nav a { padding:7px 12px; border:1px solid transparent; border-radius:999px; color:var(--muted); }
  nav a:hover { border-color:var(--line); opacity:1; color:var(--ink); }
  .top-cta { font:10px var(--mono); border:1px solid var(--ink); border-radius:999px; padding:7px 14px; }
  .top-cta:hover { background:var(--ink); color:var(--paper); opacity:1; }

  .hero { padding:52px 0 72px; }
  .hero-grid { display:grid; grid-template-columns:1fr 1fr; gap:48px; align-items:start; }
  .hero-copy h1 { font-size:clamp(40px, 6vw, 72px); line-height:1; letter-spacing:-.03em; font-weight:800; margin:14px 0 18px; }
  .period { font-weight:400; }
  .hero-description { max-width:440px; font-size:18px; line-height:1.6; color:var(--muted); margin:0 0 28px; }
  .hero-actions { display:flex; align-items:center; gap:24px; margin-bottom:26px; }
  .text-link { font-size:10px; }
  .hero-tags { display:flex; flex-wrap:wrap; gap:8px; }
  .hero-tags span { border:1px solid var(--line); border-radius:999px; padding:6px 12px; font-size:10px; letter-spacing:.06em; color:var(--muted); }

  .app-window { border:1px solid var(--line); border-radius:var(--radius); overflow:hidden; background:var(--paper); }
  .app-titlebar { display:flex; align-items:center; gap:7px; padding:10px 14px; border-bottom:1px solid var(--line); background:var(--soft); }
  .dot { width:9px; height:9px; border-radius:50%; background:#c7c7c0; }
  .dot:nth-child(2) { background:#b3b3aa; }
  .dot:nth-child(3) { background:#9c9c92; }
  .app-path { margin-left:auto; color:var(--muted); font-size:10px; letter-spacing:.04em; }
  .app-tabs { display:flex; gap:0; overflow-x:auto; border-bottom:1px solid var(--line); padding:0 12px; }
  .app-body { display:grid; grid-template-columns:132px 1fr; }
  .app-sidebar { border-right:1px solid var(--line); background:var(--soft); padding:14px 12px; display:flex; flex-direction:column; gap:10px; }
  .chip { display:flex; justify-content:space-between; gap:6px; border:1px solid var(--line); border-radius:6px; padding:6px 8px; font-size:10px; background:var(--paper); }
  .chip strong { font-size:11px; }
  .app-graphic { padding:14px 16px 10px; }

  .tab { font-size:10px; letter-spacing:.06em; color:var(--muted); border-bottom:2px solid transparent; }
  .tab.active { color: var(--accent); border-bottom-color: var(--accent); font-weight:600; }
  .app-tabs .tab { padding:10px 10px; white-space:nowrap; }
  .tab-strip .tab { padding:16px 18px 16px 0; margin-right:18px; }

  .graphic-label,.graphic-foot { display:flex; justify-content:space-between; color:var(--muted); font:9px var(--mono); letter-spacing:.08em; }
  .app-graphic svg { display:block; width:100%; height:auto; margin:10px 0 2px; }
  .axis,.gridline { fill:none; stroke:#c8c8c0; stroke-width:1; }
  .gridline { stroke-dasharray:3 7; }
  .spectrum { fill:none; stroke:#111; stroke-width:2.5; stroke-linejoin:round; stroke-linecap:round; }
  .peak { stroke:#888; stroke-width:1; stroke-dasharray:3 5; }
  .app-graphic circle { fill:#111; }

  .section { padding:90px 0; }
  .panel { background:var(--soft); }

  .about-banner { margin:0 0 32px; border:1px solid var(--line); border-radius:var(--radius); overflow:hidden; background:var(--soft); }
  .about-banner img { display:block; width:100%; height:clamp(220px, 32vw, 420px); object-fit:cover; filter:grayscale(1) contrast(1.05); }
  .about-banner figcaption { padding:10px 14px; font-size:9px; letter-spacing:.08em; color:var(--muted); border-top:1px solid var(--line); }
  .about-text { max-width:860px; margin-bottom:40px; }
  .about-text p { color:var(--muted); line-height:1.85; font-size:15px; margin:0; }
  .about-text strong { color:var(--ink); font-weight:700; }

  .stat-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin-top:8px; }
  .stat-card { border:1px solid var(--line); border-radius:var(--radius); padding:22px 20px; display:flex; flex-direction:column; gap:10px; background:var(--paper); }
  .stat-card strong { font-size:30px; letter-spacing:-.03em; }
  .stat-card span { color:var(--muted); font:10px/1.6 var(--mono); text-transform:uppercase; }

  .feature-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin-top:8px; }
  .feature-card { border:1px solid var(--line); border-radius:var(--radius); padding:20px 20px 46px; position:relative; background:var(--paper); min-height:200px; }
  .feature-card h3 { font-size:18px; line-height:1.25; letter-spacing:-.02em; font-weight:600; margin:16px 0 10px; }
  .feature-card p { font-size:13px; line-height:1.65; color:var(--muted); }
  .feature-arrow { position:absolute; bottom:16px; right:18px; font-size:15px; color:var(--muted); }
  .feature-arrow.accent { color: var(--accent); }
  .tab-strip { display:flex; flex-wrap:wrap; gap:0; margin-top:36px; border-top:1px solid var(--line); }

  .parameter-layout { display:grid; grid-template-columns:1.2fr .8fr; gap:24px; align-items:start; }
  .panel-card { border:1px solid var(--line); border-radius:var(--radius); background:var(--paper); }
  .parameter-list.panel-card { padding:4px 18px; }
  .parameter { display:grid; grid-template-columns:50px 1fr 20px; gap:14px; align-items:center; padding:18px 0; border-top:1px solid var(--line); }
  .parameter:first-child { border-top:0; }
  .parameter strong { font-size:16px; font-weight:600; }
  .parameter-arrow { color: var(--accent); }
  .output-card.panel-card { padding:18px; }
  .output-visual { height:220px; background:#e7e7e1; margin:15px 0; position:relative; overflow:hidden; border-radius:6px; }
  .map-grid { position:absolute; inset:0; opacity:.65; background-image:linear-gradient(#c5c5bd 1px,transparent 1px),linear-gradient(90deg,#c5c5bd 1px,transparent 1px); background-size:22px 22px; }
  .map-grid:after { content:""; position:absolute; inset:20% 18%; background:radial-gradient(ellipse at 48% 52%, #171715 0 3%, #55554f 4% 9%, #9a9a91 10% 17%, transparent 18%); filter:blur(3px); }
  .map-cross { position:absolute; width:30px; height:30px; left:50%; top:50%; transform:translate(-50%,-50%); border:1px solid #111; border-radius:50%; }
  .map-cross:before,.map-cross:after { content:""; position:absolute; background:#111; }
  .map-cross:before { width:46px; height:1px; left:-9px; top:14px; }
  .map-cross:after { width:1px; height:46px; top:-9px; left:14px; }
  .map-tag { position:absolute; bottom:10px; left:10px; font-size:8px; background:#f5f5f2; padding:5px 7px; border-radius:4px; }
  .output-card p { color:var(--muted); font-size:12px; line-height:1.7; margin-bottom:2px; }

  .context { padding:90px 0; }
  .context-inner { display:grid; grid-template-columns:1fr 2fr; gap:30px 40px; }
  .context-inner h2 { grid-column:2; font-size:clamp(32px,5vw,52px); line-height:1.05; letter-spacing:-.03em; font-weight:600; margin:0; }
  .context-inner h2 em { font-family:Georgia,serif; font-weight:400; }
  .context-inner p { grid-column:2; max-width:560px; color:var(--muted); line-height:1.8; margin:8px 0 0; }

  .data-strip { display:flex; align-items:center; justify-content:space-between; gap:20px; padding:18px 20px; flex-wrap:wrap; }
  .data-strip strong { font:11px var(--mono); letter-spacing:.06em; }
  .team-bottom { display:flex; justify-content:space-between; align-items:center; padding-top:28px; }
  .credits { display:flex; flex-direction:column; gap:8px; }
  .credits .eyebrow { margin:0; display:flex; align-items:baseline; gap:6px; }
  .credit-name { font:14px var(--sans); font-weight:600; letter-spacing:-.01em; text-transform:none; color:var(--ink); }
  .footer { border-top:1px solid var(--line); padding:22px 0; }
  .footer-inner { display:flex; align-items:center; justify-content:space-between; }

  @media(max-width:900px) {
    .hero-grid { grid-template-columns:1fr; }
    .app-body { grid-template-columns:1fr; }
    .app-sidebar { flex-direction:row; flex-wrap:wrap; border-right:0; border-bottom:1px solid var(--line); }
  }
  @media(max-width:800px) {
    nav { display:none; }
    .topline { padding-inline:16px; }
    .stat-grid { grid-template-columns:repeat(2,1fr); }
    .feature-grid { grid-template-columns:repeat(2,1fr); }
    .parameter-layout { grid-template-columns:1fr; gap:24px; }
    .context-inner { grid-template-columns:1fr; }
    .context-inner h2,.context-inner p { grid-column:1; }
  }
  @media(max-width:520px) {
    .stat-grid { grid-template-columns:1fr; }
    .feature-grid { grid-template-columns:1fr; }
    .hero-actions { flex-direction:column; align-items:flex-start; gap:14px; }
    .team-bottom,.footer-inner { align-items:flex-start; flex-direction:column; gap:18px; }
    .data-strip { align-items:flex-start; flex-direction:column; }
  }
</style>
