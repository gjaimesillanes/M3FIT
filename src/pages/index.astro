---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import ngc6523 from "../assets/ngc6523-bvo.jpg";
const features = [
  ["01", "Data ingestion & setup", "Upload ALMA spectral cubes, species catalogs and fitting configuration before launching a run."],
  ["02", "SLURM-managed fitting", "Launch and monitor multi-pixel, multi-species LTE fitting jobs across HPC resources, with ML-assisted strategy selection."],
  ["03", "Species-resolved inspection", "Browse single- and multi-species results pixel by pixel, with convergence history and live diagnostics."],
  ["04", "Volumetric & synthetic tools", "Render 3D parameter volumes, generate synthetic spectra and inspect transition-combination maps."]
];
const parameters = ["Column density · log N", "Excitation temperature · Tex", "Line-of-sight velocity · VLSR", "Linewidth · FWHM"];
const tabs = [
  "A. Upload",
  "B. Launch Jobs",
  "C. Multiple Species Viewer",
  "D. Single Species Viewer",
  "E. 3D Volume",
  "TMP: Synthetic Spectra Generator",
  "TMP: Launch Jobs by Epochs",
  "TMP: Transition Combo Maps"
];
const metrics = [
  ["Tex", "132 K"],
  ["log N", "14.8"],
  ["VLSR", "41.2 km/s"],
  ["FWHM", "6.4 km/s"]
];
---
<BaseLayout>
  <section id="top" class="hero-banner" aria-label="NGC 6523 Lagoon Nebula background banner">
    <div class="hero-banner-media">
      <Image src={ngc6523} alt="NGC 6523, the Lagoon Nebula, illustrative deep-sky background" width={2400} />
    </div>
    <div class="hero-banner-overlay"></div>
    <div class="topline">
      <a class="brand" href="#top"><span class="brand-mark">M³</span><span>AI-ITACA PROJECT</span></a>
      <nav aria-label="Main navigation">
        <a href="#about">ABOUT</a><a href="#workflow">INTERFACE</a><a href="#science">SCIENCE</a>
      </nav>
      <a class="top-cta" href="https://github.com/" target="_blank" rel="noreferrer">GITHUB ↗</a>
    </div>
    <div class="hero-content wrap hero-layout">
      <div class="hero-copy">
        <div class="logo-row" aria-label="Project logos">
          <img src="/M3FIT/logos/LOGO-CAB_VERSION-COMPACTA_COLOR_FONDO-BLN-CIRCTRANS-CUADR_low-300x300.png" alt="CAB logo" />
          <img src="/M3FIT/logos/Momentum-sinfondo-e1722340304295.png" alt="Momentum logo" />
          <img src="/M3FIT/logos/logo-CSIC-big.jpg" alt="CSIC logo" />
        </div>
        <strong>(Multi-species Molecular Machine-learning-assisted FITting)</strong>
        <h1>M<sup>3</sup>FIT<span class="period">.</span></h1>
        <p class="hero-description">An HPC-based multi-species LTE spectral fitting tool, assisted by machine learning, for complete ALMA spectral cubes modelling.</p>
      </div>
      <div class="hero-slideshow" aria-label="Diffusion image carousel">
        <div class="slideshow-frame">
          <img src="/M3FIT/diffusion/22.png" alt="Diffusion visualization" class="slide active" />
          <img src="/M3FIT/diffusion/23.png" alt="Diffusion visualization" class="slide" />
          <img src="/M3FIT/diffusion/24.png" alt="Diffusion visualization" class="slide" />
          <img src="/M3FIT/diffusion/25.png" alt="Diffusion visualization" class="slide" />
          <img src="/M3FIT/diffusion/26.png" alt="Diffusion visualization" class="slide" />
          <img src="/M3FIT/diffusion/27.png" alt="Diffusion visualization" class="slide" />
          <img src="/M3FIT/diffusion/28.png" alt="Diffusion visualization" class="slide" />
          <img src="/M3FIT/diffusion/29.png" alt="Diffusion visualization" class="slide" />
          <img src="/M3FIT/diffusion/30.png" alt="Diffusion visualization" class="slide" />
          <img src="/M3FIT/diffusion/31.png" alt="Diffusion visualization" class="slide" />
        </div>
      </div>
      <div class="hero-actions">
        <a class="button" href="#about">EXPLORE THE PROJECT <span>↘</span></a>
        <a class="text-link mono" href="#workflow">DISCOVER THE INTERFACE ↗</a>
      </div>
      <div class="hero-tags mono">
        <span>HPC</span><span>LTE</span><span>ML</span><span>SLURM</span><span>ALMA</span>
      </div>
    </div>
    <span class="hero-scroll mono">SCROLL ↓</span>
  </section>

  <main>
    <section id="about" class="section wrap">
      <div class="section-head">
        <span class="eyebrow">01 / THE PROJECT</span>
        <div><h2><strong>(Multi-species Molecular Machine-learning-assisted FITting)</strong><br /<strong>M³FIT</strong>/h2></div>
      </div>
      <div class="about-full">
        <p><strong>M³FIT</strong>  tool is a High-Performance Computing (HPC)-based software developed within the framework of the <strong>Artificial Intelligence Integral Tool for AstroChemical Analysis</strong> (<strong>AI-ITACA</strong>, ID: MMT24-CAB-01 - Momentum program). It combines multi-species Local Thermodynamic Equilibrium (LTE) spectral fitting with Machine Learning (ML) techniques to enable the efficient and semi-automated characterization of complete ALMA spectral cubes. Running on a SLURM-managed HPC infrastructure, the tool is designed to identify suitable molecular transitions, optimize fitting strategies, and characterize large numbers of spatial pixels across spectral cubes. Depending on the available observational constraints, it derives key physical parameters, including column density (log <em>N</em>), excitation temperature <em>T</em>ex, line-of-sight velocity <em>V</em>LSR, and linewidth (Full Width at Half Maximum, FWHM), producing spatially resolved FITS maps, synthetic LTE spectra, and fitting diagnostics to assess the quality of the solutions. The initial scientific exploitation will focus on the identification and characterization of molecular sources using datasets from GUAPOS project and ALMA Science Verification observations.</p>
      </div>
      <div class="stat-grid">
        <div class="stat-card"><strong>HPC</strong><span>SLURM-managed<br />job orchestration</span></div>
        <div class="stat-card"><strong>ML</strong><span>Strategy selection<br />and convergence guidance</span></div>
        <div class="stat-card"><strong>LTE</strong><span>Multi-species<br />spectral modelling</span></div>
        <div class="stat-card"><strong>FITS</strong><span>Spatially resolved<br />physical-parameter maps</span></div>
      </div>
    </section>

    <section id="workflow" class="section panel">
      <div class="wrap">
        <div class="plot-figure">
          <div id="spectrum-chart" class="spectrum-chart" data-src="/M3FIT/data/ch3ocho_spectrum.json" aria-label="Interactive CH3OCHO pixel x=124, y=123 spectrum, zoomable and pannable"></div>
          <p class="plot-figure-caption">CH₃OCHO spectrum — G31.41+0.31, pixel x=124, y=123. Drag to zoom, double-click to reset, scroll to pan.</p>
        </div>
        <div class="section-head">
          <span class="eyebrow">02 / WORKFLOW</span>
          <div><h2>Workflow:</h2></div>
        </div>

        <div class="workflow-grid">
          <article class="workflow-step">
            <span class="step-number">01</span>
            <h3>Launch and configure</h3>
            <p>Start the application and initialize the fitting environment on the HPC cluster. The interface is designed to keep the setup simple while preserving full control over the analysis configuration.</p>
          </article>

          <article class="workflow-step">
            <span class="step-number">02</span>
            <h3>Upload observational data</h3>
            <p>Load the ALMA spectral cubes, molecular catalogs, and fitting parameters needed to define the target species and the spectral region to be modeled.</p>
          </article>

          <article class="workflow-step">
            <span class="step-number">03</span>
            <h3>Run the LTE fitting</h3>
            <p>Submit multi-pixel fitting jobs through SLURM, monitor their execution, and use ML-assisted recommendations to guide the selection of the most appropriate spectral strategy.</p>
          </article>

          <article class="workflow-step">
            <span class="step-number">04</span>
            <h3>Inspect and validate results</h3>
            <p>Examine fitted spectra, convergence diagnostics, and spatially resolved parameter maps to verify the physical consistency of each solution across the cube.</p>
          </article>
        </div>

        <div class="demo-gallery" aria-label="M3FIT workflow demonstrations">
          <article class="demo-card">
            <h3>1. Launch the App</h3>
            <img src="/M3FIT/demo/launch-app.gif" alt="Launch the app demo animation" />
          </article>

          <article class="demo-card">
            <h3>2. Upload Files and Launch the Fitting Jobs</h3>
            <img src="/M3FIT/demo/upload-and-launch.gif" alt="Upload files and launch fitting jobs demo animation" />
          </article>

          <article class="demo-card demo-card-wide">
            <h3>3. Visualize Progress and Fitted Spectrum (Per pixel)</h3>
            <div class="demo-inline">
              <img src="/M3FIT/demo/progress-spectrum-1.gif" alt="Progress monitoring demo animation" />
              <img src="/M3FIT/demo/progress-spectrum-2.gif" alt="Fitted spectrum per pixel demo animation" />
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="context panel">
      <div class="wrap context-inner">
        <span class="eyebrow">04 / SCIENTIFIC MOTIVATION</span>
        <h2>Objective:<br /><em>Identification of optimal LTE transition lines</em><br />and characterization of multiple voxels in spectral cubes</h2>
        <p>The identification of optimal transition lines is a central requirement for achieving robust LTE convergence in molecular line analysis. The increasing complexity and size of spectral cubes make it necessary to automate the selection of physically suitable transitions and to apply reproducible fitting strategies across large data sets. M³FIT addresses these challenges by combining LTE spectral modeling with machine-learning-assisted optimization to enable the spatial characterization of multiple voxels within spectral cubes.</p>
      </div>
    </section>

    <section class="section wrap">
      <p class="funding-note">“The funding for these actions/grants and contracts comes from the European Union's Recovery and Resilience Facility-Next Generation, in the framework of the General Invitation of the Spanish Government’s public business entity Red.es to participate in talent attraction and retention programmes within Investment 4 of Component 19 of the Recovery, Transformation and Resilience Plan”.</p>
    </section>

    <section id="team" class="section wrap team">
      <div class="section-head">
      </div>
      <div class="data-strip panel-card">
        <span class="eyebrow">INITIAL DATASETS</span>
        <strong>GUAPOS</strong><strong>ALMA SCIENCE VERIFICATION</strong>
      </div>
      <div class="team-bottom">
        <div class="credits">
          <p class="eyebrow">PI · <strong class="credit-name">Victor Rivilla Rodríguez</strong></p>
          <p class="eyebrow">Dev · <strong class="credit-name">Gabriel Jaimes Illanes</strong></p>
        </div>
        <a class="button light" href="https://github.com/" target="_blank" rel="noreferrer">VIEW SOURCE CODE <span>↗</span></a>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap footer-inner">
      <a class="brand" href="#top"><span class="brand-mark">M³</span><span>M³FIT / AI-ITACA</span></a>
      <span class="eyebrow">© 2026 · AI-ITACA · CSIC / Centro de Astrobiología</span>
      <a class="eyebrow" href="#top">BACK TO TOP ↑</a>
    </div>
  </footer>
</BaseLayout>

<script src="https://cdn.plot.ly/plotly-2.35.2.min.js" is:inline></script>

<script>
  const slides = Array.from(document.querySelectorAll('.slide'));
  let currentSlide = 0;

  if (slides.length > 1) {
    setInterval(() => {
      slides[currentSlide].classList.remove('active');
      currentSlide = (currentSlide + 1) % slides.length;
      slides[currentSlide].classList.add('active');
    }, 1800);
  }
</script>

<script is:inline>
  (function () {
    function renderSpectrumChart() {
      var el = document.getElementById('spectrum-chart');
      if (!el || typeof Plotly === 'undefined') return;
      var src = el.getAttribute('data-src');
      el.innerHTML = '<div class="spectrum-loading">LOADING SPECTRUM…</div>';

      fetch(src)
        .then(function (res) { return res.json(); })
        .then(function (data) {
          el.innerHTML = '';

          var traces = [
            {
              x: data.synthetic_alltrans.freq_ghz,
              y: data.synthetic_alltrans.value,
              mode: 'lines',
              name: 'Synthetic all-trans',
              line: { color: '#4caf50', width: 1.2 },
              opacity: 0.85,
            },
            {
              x: data.synthetic_selected.freq_ghz,
              y: data.synthetic_selected.value,
              mode: 'lines',
              name: 'Synthetic selected',
              line: { color: '#1f6feb', width: 1.6 },
            },
            {
              x: data.observed.freq_ghz,
              y: data.observed.value,
              mode: 'lines',
              name: 'Observed',
              line: { color: '#111111', width: 1.3 },
            },
          ];

          var shapes = (data.best_fit_transitions_ghz || []).map(function (freq) {
            return {
              type: 'line',
              x0: freq, x1: freq, y0: 0, y1: 1,
              xref: 'x', yref: 'paper',
              line: { color: '#9a9a9a', width: 1, dash: 'dot' },
            };
          });

          var initialRange = data.default_range_ghz || [
            Math.min.apply(null, data.observed.freq_ghz),
            Math.max.apply(null, data.observed.freq_ghz),
          ];

          var pixelLabel = data.pixel ? (' \u2014 pixel x=' + data.pixel.x + ', y=' + data.pixel.y) : '';

          Plotly.newPlot(el, traces, {
            title: { text: (data.species || '') + ': ' + (data.source || '') + pixelLabel, font: { size: 15, family: 'DM Mono, monospace', color: '#111' } },
            xaxis: { title: 'Frequency (GHz)', range: initialRange, gridcolor: '#eee', zeroline: false },
            yaxis: { title: 'T_B (K)', gridcolor: '#eee', zeroline: true, zerolinecolor: '#ddd' },
            shapes: shapes,
            margin: { l: 56, r: 24, t: 48, b: 46 },
            legend: { orientation: 'h', y: -0.22, font: { size: 10 } },
            hovermode: 'x unified',
            plot_bgcolor: '#ffffff',
            paper_bgcolor: '#ffffff',
            font: { family: 'Manrope, sans-serif', size: 11, color: '#333' },
          }, {
            responsive: true,
            scrollZoom: true,
            displaylogo: false,
            modeBarButtonsToRemove: ['lasso2d', 'select2d'],
          });
        })
        .catch(function (err) {
          el.innerHTML = '<div class="spectrum-loading">Unable to load spectrum data.</div>';
          console.error('Spectrum chart load failed:', err);
        });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', renderSpectrumChart);
    } else {
      renderSpectrumChart();
    }
  })();
</script>

<style>
  .topline { height: 72px; display:flex; align-items:center; justify-content:space-between; padding:0 max(24px, calc((100vw - 1160px)/2)); border-bottom:1px solid var(--line); gap:24px; }
  .brand { display:flex; align-items:center; gap:12px; font:10px var(--mono); letter-spacing:.08em; }
  .brand-mark { display:grid; place-items:center; width:30px; height:30px; border:1px solid var(--ink); border-radius:50%; font:700 12px var(--sans); letter-spacing:-.04em; }
  nav { display:flex; gap:8px; font:10px var(--mono); letter-spacing:.06em; }
  nav a { padding:7px 12px; border:1px solid transparent; border-radius:999px; color:var(--muted); }
  nav a:hover { border-color:var(--line); opacity:1; color:var(--ink); }
  .top-cta { font:10px var(--mono); border:1px solid var(--ink); border-radius:999px; padding:7px 14px; }
  .top-cta:hover { background:var(--ink); color:var(--paper); opacity:1; }

  .hero-banner { position:relative; min-height:78vh; display:flex; flex-direction:column; justify-content:center; overflow:hidden; color:#fff; --page-gutter: clamp(52px, 6vw, 120px); }
  .hero-banner-media { position:absolute; inset:0; z-index:0; }
  .hero-banner-media img { display:block; width:100%; height:100%; object-fit:cover; filter:grayscale(1) contrast(1.1) brightness(.7); }
  .hero-banner-overlay { position:absolute; inset:0; z-index:1; background:linear-gradient(180deg, rgba(0,0,0,.42) 0%, rgba(0,0,0,.32) 42%, rgba(0,0,0,.8) 100%); }
  .hero-banner .topline { position:absolute; top:0; left:0; right:0; z-index:3; background:transparent; border-bottom:1px solid rgba(255,255,255,.18); }
  .hero-banner .brand,.hero-banner nav a,.hero-banner .top-cta { color:#fff; }
  .hero-banner .brand-mark { border-color:#fff; }
  .hero-banner nav a:hover { border-color:rgba(255,255,255,.4); color:#fff; }
  .hero-banner .top-cta { border-color:#fff; }
  .hero-banner .top-cta:hover { background:#fff; color:#111; }

  .hero-banner .wrap { width: min(1600px, calc(100% - var(--page-gutter) - var(--page-gutter))); }
  .hero-content { position:relative; z-index:2; padding-top:52px; }
  .hero-layout { display:grid; grid-template-columns:minmax(0, 1.2fr) minmax(420px, 760px); align-items:center; gap:32px; }
  .hero-copy { max-width:680px; }
  .logo-row { display:flex; align-items:center; justify-content:flex-start; gap:18px; flex-wrap:nowrap; margin:0 0 14px; max-width:100%; }
  .logo-row img { height:118px; width:auto; max-width:220px; object-fit:contain; filter: brightness(1.05); }
  .hero-content .eyebrow { color:rgba(255,255,255,.75); }
  .hero-content h1 { font-size:clamp(42px, 6.4vw, 92px); line-height:.95; letter-spacing:-.03em; font-weight:800; margin:16px 0 18px; color:#fff; }
  .period { font-weight:400; }
  .hero-content .hero-description { max-width:520px; font-size:clamp(15px, 1.7vw, 18px); line-height:1.6; color:rgba(255,255,255,.86); margin:0 0 24px; }
  .hero-slideshow { justify-self:end; align-self:center; width:min(80%, 520px); margin-top:20px; }
  .slideshow-frame { position:relative; width:100%; aspect-ratio:1 / 1; overflow:hidden; border-radius:18px; border:1px solid rgba(255,255,255,.5); background:rgba(255,255,255,.08); box-shadow:0 30px 80px rgba(0,0,0,.38); backdrop-filter:blur(12px); }
  .slideshow-frame .slide { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:0; transition:opacity 0.9s ease; }
  .slideshow-frame .slide.active { opacity:1; }
  .hero-content .hero-actions { display:flex; align-items:center; gap:24px; margin-bottom:28px; }
  .hero-content .button { background:#fff; color:#111; border-color:#fff; }
  .hero-content .button:hover { background:transparent; color:#fff; }
  .hero-content .text-link { color:#fff; }
  .hero-content .hero-tags span { border-color:rgba(255,255,255,.4); color:rgba(255,255,255,.88); }
  .hero-scroll { position:absolute; left:50%; bottom:26px; transform:translateX(-50%); z-index:2; font-size:10px; letter-spacing:.16em; color:rgba(255,255,255,.72); }

  .text-link { font-size:10px; }
  .hero-tags { display:flex; flex-wrap:wrap; gap:8px; }
  .hero-tags span { border:1px solid var(--line); border-radius:999px; padding:6px 12px; font-size:10px; letter-spacing:.06em; color:var(--muted); }

  #workflow .wrap { width: min(1600px, calc(100% - 12px)); }
  .plot-figure { margin:8px 0 36px; background:var(--paper); border:1px solid var(--line); border-radius:var(--radius); overflow:hidden; box-shadow:0 18px 40px rgba(17,17,17,.04); }
  .spectrum-chart { width:100%; height:min(85vh, 980px); min-height:620px; background:#fff; box-sizing:border-box; }
  .spectrum-chart .spectrum-loading { display:flex; align-items:center; justify-content:center; height:100%; color:var(--muted); font:11px var(--mono); letter-spacing:.08em; }
  .plot-figure-caption { margin:0; padding:12px 20px 18px; color:var(--muted); font:11px var(--mono); letter-spacing:.04em; text-align:center; border-top:1px solid var(--line); }
  .workflow-grid { display:grid; grid-template-columns:repeat(4, minmax(0, 1fr)); gap:18px; margin:32px 0 40px; }
  .workflow-step { background:var(--paper); border:1px solid var(--line); border-radius:var(--radius); padding:22px 20px; min-height:240px; }
  .step-number { display:inline-block; margin-bottom:18px; font:10px var(--mono); letter-spacing:.08em; color:var(--muted); }
  .workflow-step h3 { margin:0 0 12px; font-size:22px; line-height:1.2; letter-spacing:-.03em; }
  .workflow-step p { margin:0; color:var(--muted); line-height:1.7; font-size:14px; }

  .demo-gallery { display:grid; grid-template-columns:repeat(2, minmax(0, 1fr)); gap:28px; margin:0 0 44px; }
  .demo-card { background:var(--paper); border:1px solid var(--line); border-radius:var(--radius); padding:22px; }
  .demo-card h3 { margin:0 0 14px; font-size:18px; letter-spacing:-.02em; }
  .demo-card img { display:block; width:100%; border:1px solid var(--line); border-radius:10px; background:#fff; }
  .demo-card-wide { grid-column:1 / -1; }
  .demo-inline { display:grid; grid-template-columns:repeat(2, minmax(0, 1fr)); gap:18px; }

  .tab { font-size:10px; letter-spacing:.06em; color:var(--muted); border-bottom:2px solid transparent; }
  .tab.active { color: var(--accent); border-bottom-color: var(--accent); font-weight:600; }
  .app-tabs .tab { padding:10px 10px; white-space:nowrap; }
  .tab-strip .tab { padding:16px 18px 16px 0; margin-right:18px; }

  .graphic-label,.graphic-foot { display:flex; justify-content:space-between; color:var(--muted); font:9px var(--mono); letter-spacing:.08em; }
  .app-graphic svg { display:block; width:100%; height:auto; margin:10px 0 2px; }
  .axis,.gridline { fill:none; stroke:#c8c8c0; stroke-width:1; }
  .gridline { stroke-dasharray:3 7; }
  .spectrum { fill:none; stroke:#111; stroke-width:2.5; stroke-linejoin:round; stroke-linecap:round; }
  .peak { stroke:#888; stroke-width:1; stroke-dasharray:3 5; }
  .app-graphic circle { fill:#111; }

  .section { padding:90px 0; --page-gutter: clamp(52px, 6vw, 120px); }
  .panel { background:var(--soft); }
  .section.wrap, .section > .wrap { width: min(1600px, calc(100% - var(--page-gutter) - var(--page-gutter))); }

  .about-full { width:100%; margin-bottom:40px; }
  .about-full p { color:var(--muted); line-height:1.9; font-size:15px; margin:0; max-width:100%; text-align:justify; }
  .about-full strong { color:var(--ink); font-weight:700; }
  .funding-note { margin:0 auto; color:var(--muted); font:20px/1.8 Georgia, serif; font-style:italic; text-align:center; max-width:960px; }

  .stat-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin-top:8px; }
  .stat-card { border:1px solid var(--line); border-radius:var(--radius); padding:22px 20px; display:flex; flex-direction:column; gap:10px; background:var(--paper); }
  .stat-card strong { font-size:30px; letter-spacing:-.03em; }
  .stat-card span { color:var(--muted); font:10px/1.6 var(--mono); text-transform:uppercase; }

  .feature-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin-top:8px; }
  .feature-card { border:1px solid var(--line); border-radius:var(--radius); padding:20px 20px 46px; position:relative; background:var(--paper); min-height:200px; }
  .feature-card h3 { font-size:18px; line-height:1.25; letter-spacing:-.02em; font-weight:600; margin:16px 0 10px; }
  .feature-card p { font-size:13px; line-height:1.65; color:var(--muted); }
  .feature-arrow { position:absolute; bottom:16px; right:18px; font-size:15px; color:var(--muted); }
  .feature-arrow.accent { color: var(--accent); }
  .tab-strip { display:flex; flex-wrap:wrap; gap:0; margin-top:36px; border-top:1px solid var(--line); }

  .parameter-layout { display:grid; grid-template-columns:1.2fr .8fr; gap:24px; align-items:start; }
