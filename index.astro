---
import BaseLayout from "../layouts/BaseLayout.astro";
const features = [
  ["01", "Multi-species LTE fitting", "Simultaneous modelling of molecular species within complex astronomical spectra."],
  ["02", "Machine-learning assistance", "Guidance for transition identification, fitting strategies and large-scale analysis."],
  ["03", "HPC-ready workflow", "Designed to process many spatial pixels across ALMA spectral cubes on SLURM-managed systems."],
  ["04", "Spatially resolved products", "Physical-parameter maps, synthetic spectra and diagnostics for solution assessment."]
];
const parameters = ["Column density · log N", "Excitation temperature · Tex", "Line-of-sight velocity · VLSR", "Linewidth · FWHM"];
---
<BaseLayout>
  <div class="topline">
    <a class="brand" href="#top"><span class="brand-mark">S.</span><span>SCIENTIFIC SOFTWARE / ASTROCHEMISTRY</span></a>
    <nav aria-label="Main navigation">
      <a href="#about">ABOUT</a><a href="#workflow">WORKFLOW</a><a href="#science">SCIENCE</a><a href="#team">TEAM</a>
    </nav>
    <a class="top-cta" href="https://github.com/" target="_blank" rel="noreferrer">GITHUB ↗</a>
  </div>

  <main id="top">
    <section class="hero wrap">
      <div class="hero-meta">
        <span class="eyebrow">AI-ITACA / RESEARCH SOFTWARE</span>
        <span class="eyebrow">HPC · LTE · MACHINE LEARNING</span>
      </div>
      <div class="hero-title">
        <p class="hero-kicker mono">Decoding molecular complexity</p>
        <h1>SMAX<span class="period">.</span></h1>
        <div class="hero-bottom">
          <p class="hero-description">Multi-species molecular spectral fitting, assisted by machine learning.</p>
          <p class="hero-index mono">A scalable approach<br />to ALMA spectral cubes</p>
        </div>
      </div>
      <div class="hero-graphic" aria-label="Abstract monochrome spectral line illustration">
        <div class="graphic-label mono">FIG. 01 / SPECTRAL SIGNATURE</div>
        <svg viewBox="0 0 1100 250" role="img" aria-label="Illustrative molecular spectral lines">
          <path class="axis" d="M0 205H1100 M40 20V220" />
          <path class="gridline" d="M40 65H1100 M40 135H1100" />
          <path class="spectrum" d="M40 203 L100 202 145 200 185 201 220 197 245 188 260 100 270 185 290 198 340 201 390 199 420 193 438 150 450 196 480 201 535 199 565 194 590 75 603 188 620 198 680 201 720 199 745 182 765 120 778 190 805 199 850 201 900 200 925 188 940 45 953 185 975 199 1030 202 1100 201" />
          <path class="peak" d="M260 100V220 M590 75V220 M940 45V220" />
          <circle cx="260" cy="100" r="4"/><circle cx="590" cy="75" r="4"/><circle cx="940" cy="45" r="4"/>
        </svg>
        <div class="graphic-foot mono"><span>INTENSITY</span><span>FREQUENCY →</span><span>ILLUSTRATIVE DATA</span></div>
      </div>
      <div class="hero-actions">
        <a class="button" href="#about">EXPLORE THE PROJECT <span>↘</span></a>
        <a class="text-link mono" href="#workflow">DISCOVER THE WORKFLOW ↗</a>
      </div>
    </section>

    <section class="ticker" aria-label="Project keywords">
      <div class="ticker-inner mono"><span>MOLECULAR SPECTROSCOPY</span><b>✳</b><span>LOCAL THERMODYNAMIC EQUILIBRIUM</span><b>✳</b><span>ALMA DATA</span><b>✳</b><span>HIGH-PERFORMANCE COMPUTING</span><b>✳</b><span>MACHINE LEARNING</span></div>
    </section>

    <section id="about" class="section wrap">
      <div class="section-head">
        <span class="eyebrow">01 / THE PROJECT</span>
        <div><h2>From complex spectra<br />to physical insight.</h2>
          <p>SMAX is an HPC-based software framework developed within the Artificial Intelligence Integral Tool for AstroChemical Analysis (AI-ITACA). It combines multi-species Local Thermodynamic Equilibrium (LTE) modelling with machine-learning techniques to support the efficient, semi-automated analysis of complete ALMA spectral cubes.</p>
        </div>
      </div>
      <div class="stat-row">
        <div><strong>01</strong><span>Multi-species<br />spectral modelling</span></div>
        <div><strong>ML</strong><span>Assisted analysis<br />and optimization</span></div>
        <div><strong>HPC</strong><span>Scalable cube<br />processing</span></div>
        <div><strong>FITS</strong><span>Spatially resolved<br />scientific products</span></div>
      </div>
    </section>

    <section id="workflow" class="section dark">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">02 / CAPABILITIES</span>
          <div><h2>Built for the scale<br />of modern surveys.</h2>
            <p>Designed to move from spectral identification to spatially resolved physical characterization, while keeping the fitting process inspectable.</p>
          </div>
        </div>
        <div class="feature-grid">
          {features.map(([n, title, desc]) => <article class="feature">
            <span class="eyebrow">{n} / CAPABILITY</span><h3>{title}</h3><p>{desc}</p><span class="feature-arrow">↗</span>
          </article>)}
        </div>
      </div>
    </section>

    <section id="science" class="section wrap">
      <div class="section-head">
        <span class="eyebrow">03 / OUTPUT PARAMETERS</span>
        <div><h2>Quantifying the<br />molecular gas.</h2>
          <p>Depending on the available observational constraints, the fitting procedure derives key physical parameters and produces diagnostic products to assess the quality of each solution.</p>
        </div>
      </div>
      <div class="parameter-layout">
        <div class="parameter-list">
          {parameters.map((p, i) => <div class="parameter"><span class="eyebrow">0{i+1}</span><strong>{p}</strong><span>↗</span></div>)}
        </div>
        <div class="output-card">
          <span class="eyebrow">OUTPUT / PRODUCTS</span>
          <div class="output-visual">
            <div class="map-grid"></div>
            <div class="map-cross"></div>
            <span class="map-tag mono">PIXEL MAP / PREVIEW</span>
          </div>
          <p>Spatially resolved FITS maps, synthetic LTE spectra and fitting diagnostics.</p>
        </div>
      </div>
    </section>

    <section class="context">
      <div class="wrap context-inner">
        <span class="eyebrow">04 / SCIENTIFIC MOTIVATION</span>
        <h2>Understanding the<br /><em>molecular inventory</em><br />of the interstellar medium.</h2>
        <p>As observational sensitivity and spectral coverage continue to grow, automated and scalable analysis methods are essential to investigate molecular complexity and the chemical ingredients connected to prebiotic chemistry.</p>
      </div>
    </section>

    <section id="team" class="section wrap team">
      <div class="section-head">
        <span class="eyebrow">05 / FRAMEWORK & DATA</span>
        <div><h2>Developed for<br />collaborative science.</h2>
          <p>SMAX is developed within AI-ITACA (PI: Víctor M. Rivilla). Initial scientific exploitation will focus on molecular-source identification and characterization using ALMA datasets.</p>
        </div>
      </div>
      <div class="data-strip">
        <span class="eyebrow">INITIAL DATASETS</span>
        <strong>ALCHEMI</strong><strong>ALMA SCIENCE VERIFICATION</strong><strong>GUAPOS</strong>
      </div>
      <div class="team-bottom">
        <p class="eyebrow">AI-ITACA / RESEARCH & DEVELOPMENT</p>
        <a class="button light" href="https://github.com/" target="_blank" rel="noreferrer">VIEW SOURCE CODE <span>↗</span></a>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap footer-inner">
      <a class="brand" href="#top"><span class="brand-mark">S.</span><span>SMAX / SCIENTIFIC SOFTWARE</span></a>
      <span class="eyebrow">© 2026 · AI-ITACA</span>
      <a class="eyebrow" href="#top">BACK TO TOP ↑</a>
    </div>
  </footer>
</BaseLayout>

<style>
  .topline { height: 76px; display:flex; align-items:center; justify-content:space-between; padding:0 max(24px, calc((100vw - 1160px)/2)); border-bottom:1px solid var(--line); gap:24px; }
  .brand { display:flex; align-items:center; gap:12px; font:10px var(--mono); letter-spacing:.08em; }
  .brand-mark { display:grid; place-items:center; width:30px; height:30px; border:1px solid var(--ink); border-radius:50%; font:700 15px var(--sans); letter-spacing:-.08em; }
  nav { display:flex; gap:28px; font:10px var(--mono); letter-spacing:.08em; }
  .top-cta { font:10px var(--mono); border-bottom:1px solid; padding-bottom:4px; }
  .hero { padding-top:44px; }
  .hero-meta { display:flex; justify-content:space-between; }
  .hero-title { padding:76px 0 54px; }
  .hero-kicker { font-size:11px; letter-spacing:.14em; margin:0 0 6px; }
  h1 { font-size:clamp(100px, 22vw, 270px); line-height:.78; letter-spacing:-.105em; font-weight:800; margin:0 0 35px -14px; }
  .period { font-weight:400; }
  .hero-bottom { display:flex; justify-content:space-between; align-items:end; }
  .hero-description { max-width:410px; font-size:clamp(20px, 3vw, 30px); line-height:1.25; letter-spacing:-.04em; margin:0; }
  .hero-index { font-size:10px; line-height:1.8; color:var(--muted); text-align:right; }
  .hero-graphic { border:1px solid var(--line); padding:18px 18px 10px; background:#eeeeea; }
  .graphic-label,.graphic-foot { display:flex; justify-content:space-between; color:var(--muted); font:9px var(--mono); letter-spacing:.08em; }
  .hero-graphic svg { display:block; width:100%; height:auto; margin:12px 0 4px; }
  .axis,.gridline { fill:none; stroke:#c8c8c0; stroke-width:1; }
  .gridline { stroke-dasharray:3 7; }
  .spectrum { fill:none; stroke:#111; stroke-width:2.5; stroke-linejoin:round; stroke-linecap:round; }
  .peak { stroke:#888; stroke-width:1; stroke-dasharray:3 5; }
  .hero-graphic circle { fill:#111; }
  .hero-actions { display:flex; align-items:center; gap:28px; padding:24px 0 48px; }
  .text-link { font-size:10px; }
  .ticker { background:var(--ink); color:var(--paper); overflow:hidden; }
  .ticker-inner { min-width:900px; display:flex; align-items:center; justify-content:space-around; gap:26px; padding:17px 24px; font-size:9px; letter-spacing:.12em; }
  .ticker b { color:#777; font-weight:400; }
  .stat-row { display:grid; grid-template-columns:repeat(4,1fr); border-top:1px solid var(--line); border-bottom:1px solid var(--line); }
  .stat-row div { padding:24px 18px 24px 0; display:flex; flex-direction:column; gap:12px; border-right:1px solid var(--line); }
  .stat-row div:not(:first-child) { padding-left:22px; }
  .stat-row div:last-child { border:0; }
  .stat-row strong { font-size:36px; letter-spacing:-.06em; }
  .stat-row span { color:var(--muted); font:10px/1.6 var(--mono); text-transform:uppercase; }
  .dark { background:#11110f; color:#f5f5f2; }
  .dark .section-head p { color:#a5a59e; }
  .dark .eyebrow { color:#a5a59e; }
  .feature-grid { display:grid; grid-template-columns:repeat(4,1fr); border-top:1px solid #454540; border-bottom:1px solid #454540; }
  .feature { min-height:260px; padding:24px 22px 20px 0; border-right:1px solid #454540; position:relative; }
  .feature:not(:first-child) { padding-left:22px; }
  .feature:last-child { border:0; }
  .feature h3 { font-size:21px; line-height:1.2; letter-spacing:-.04em; font-weight:600; margin:42px 0 12px; }
  .feature p { font-size:13px; line-height:1.7; color:#a5a59e; }
  .feature-arrow { position:absolute; bottom:18px; right:20px; font-size:17px; }
  .parameter-layout { display:grid; grid-template-columns:1.2fr .8fr; gap:70px; align-items:start; }
  .parameter { display:grid; grid-template-columns:50px 1fr 20px; gap:14px; align-items:center; padding:20px 0; border-top:1px solid var(--line); }
  .parameter:last-child { border-bottom:1px solid var(--line); }
  .parameter strong { font-size:16px; font-weight:600; }
  .output-card { border:1px solid var(--line); padding:18px; }
  .output-visual { height:220px; background:#e7e7e1; margin:15px 0; position:relative; overflow:hidden; }
  .map-grid { position:absolute; inset:0; opacity:.65; background-image:linear-gradient(#c5c5bd 1px,transparent 1px),linear-gradient(90deg,#c5c5bd 1px,transparent 1px); background-size:22px 22px; }
  .map-grid:after { content:""; position:absolute; inset:20% 18%; background:radial-gradient(ellipse at 48% 52%, #171715 0 3%, #55554f 4% 9%, #9a9a91 10% 17%, transparent 18%); filter:blur(3px); }
  .map-cross { position:absolute; width:30px; height:30px; left:50%; top:50%; transform:translate(-50%,-50%); border:1px solid #111; border-radius:50%; }
  .map-cross:before,.map-cross:after { content:""; position:absolute; background:#111; }
  .map-cross:before { width:46px; height:1px; left:-9px; top:14px; }
  .map-cross:after { width:1px; height:46px; top:-9px; left:14px; }
  .map-tag { position:absolute; bottom:10px; left:10px; font-size:8px; background:#f5f5f2; padding:5px 7px; }
  .output-card p { color:var(--muted); font-size:12px; line-height:1.7; margin-bottom:2px; }
  .context { background:#e8e8e2; padding:100px 0; }
  .context-inner { display:grid; grid-template-columns:1fr 2fr; gap:30px 40px; }
  .context-inner h2 { grid-column:2; font-size:clamp(42px,7vw,84px); line-height:.98; letter-spacing:-.07em; font-weight:600; margin:0; }
  .context-inner h2 em { font-family:Georgia,serif; font-weight:400; }
  .context-inner p { grid-column:2; max-width:560px; color:var(--muted); line-height:1.8; margin:8px 0 0; }
  .data-strip { border-top:1px solid var(--line); border-bottom:1px solid var(--line); display:flex; align-items:center; justify-content:space-between; gap:20px; padding:24px 0; flex-wrap:wrap; }
  .data-strip strong { font:11px var(--mono); letter-spacing:.06em; }
  .team-bottom { display:flex; justify-content:space-between; align-items:center; padding-top:28px; }
  .footer { border-top:1px solid var(--line); padding:22px 0; }
  .footer-inner { display:flex; align-items:center; justify-content:space-between; }
  @media(max-width:800px) {
    nav { display:none; }
    .topline { padding-inline:16px; }
    .hero-title { padding:65px 0 38px; }
    .feature-grid { grid-template-columns:repeat(2,1fr); }
    .feature:nth-child(2) { border-right:0; }
    .feature:nth-child(n+3) { border-top:1px solid #454540; }
    .feature:nth-child(3) { padding-left:0; }
    .parameter-layout { grid-template-columns:1fr; gap:38px; }
    .context-inner { grid-template-columns:1fr; }
    .context-inner h2,.context-inner p { grid-column:1; }
  }
  @media(max-width:520px) {
    .hero-meta .eyebrow:last-child { display:none; }
    .hero-bottom { align-items:start; gap:18px; flex-direction:column; }
    .hero-index { text-align:left; }
    .hero-actions { align-items:flex-start; flex-direction:column; gap:18px; }
    .stat-row { grid-template-columns:repeat(2,1fr); }
    .stat-row div:nth-child(2) { border-right:0; }
    .stat-row div:nth-child(3),.stat-row div:nth-child(4) { border-top:1px solid var(--line); }
    .stat-row div:nth-child(3) { padding-left:0; }
    .feature-grid { grid-template-columns:1fr; }
    .feature,.feature:not(:first-child) { min-height:220px; padding:22px 0; border-right:0; border-top:1px solid #454540; }
    .feature:first-child { border-top:0; }
    .feature h3 { margin-top:28px; }
    .team-bottom,.footer-inner { align-items:flex-start; flex-direction:column; gap:18px; }
    .data-strip { align-items:flex-start; flex-direction:column; }
  }
</style>
